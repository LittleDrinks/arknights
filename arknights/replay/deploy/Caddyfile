# Direct public entry and the domain route share the same lab backend.
# The SSH listener stays on loopback; 3657 serves ordinary HTTP and WebSockets.
http://:3657 {
	reverse_proxy 127.0.0.1:48181 {
		flush_interval -1
	}
}

# A browser opening the domain without a port uses HTTP port 80.
# Proxy internally to 3657 so the address bar keeps the original domain.
http://arknights.shzeno.com {
	reverse_proxy 127.0.0.1:3657 {
		flush_interval -1
	}
}

# After DNS and origin TLS are ready, change the site address above to
# arknights.shzeno.com (without http://) to let Caddy manage HTTPS.
