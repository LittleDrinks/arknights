{
  "git.repositoryScanIgnoredFolders": [
    "results",
    "runtime",
    "node_modules"
  ],
  "files.watcherExclude": {
    "**/results/**": true,
    "**/runtime/**": true
  },
  "search.exclude": {
    "results": true,
    "runtime": true,
    "node_modules": true,
    "arknights/evaluate/_legacy": true
  },
  "files.exclude": {
    "**/arknights/evaluate/_legacy": true,
    "**/node_modules": true,
    "**/__pycache__": true
  }
}
